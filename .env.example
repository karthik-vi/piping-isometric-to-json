# Copy to .env and fill in only what you need. Never commit real keys.
# VLM stage provider: none | smolvlm | anthropic
VLM_PROVIDER=none
# Only needed when VLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Local VLM override
SMOLVLM_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct
# Per-call OCR timeout in seconds
OCR_TIMEOUT_S=20
